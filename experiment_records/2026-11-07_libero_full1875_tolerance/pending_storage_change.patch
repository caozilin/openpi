+"""Store LIBERO trial metadata once in its immutable source-demo input."""
+from copy import deepcopy
+import hashlib
+import json
+import os
+from pathlib import Path
+
+REFERENCE_KEY = 'domain_randomization_ref'
+SCHEMA = 'libero.prepared_static_metadata_ref.v1'
+IDENTITY_KEYS = ('suite', 'task_id', 'demo', 'episode_index')
+STATIC_KEYS = ('robot_xml', 'assets', 'asset_sha256')
+
+
+def _document(path):
+    data = Path(path).read_bytes()
+    return json.loads(data), hashlib.sha256(data).hexdigest()
+
+
+def _identity(document, path):
+    source = document['source']
+    identity = {key: source[key] for key in IDENTITY_KEYS}
+    folder = Path(path).parent
+    if (folder.name != identity['demo']
+            or folder.parent.name != f"task_{identity['task_id']:02d}"
+            or folder.parent.parent.name != identity['suite']):
+        raise ValueError('Prepared metadata does not match its suite/task/demo folder')
+    return identity
+
+
+def compact_trial(payload, trial_path):
+    """Omit repeated metadata only when it exactly matches the bound demo.
+
+    Non-LIBERO callers keep the original representation. No shared input is
+    created, changed or inferred from a bare seed number.
+    """
+    result = payload.get('result') if isinstance(payload, dict) else None
+    if not isinstance(result, dict) or 'domain_randomization' not in result:
+        return payload
+    trial_path = Path(trial_path).resolve()
+    source_path = None
+    for folder in trial_path.parents:
+        if folder.name.startswith('demo_') and folder.parent.name.startswith('task_'):
+            candidate = folder / 'prepared_input.json'
+            if candidate.is_file():
+                source_path = candidate
+            break
+    if source_path is None:
+        return payload
+    document, digest = _document(source_path)
+    identity = _identity(document, source_path)
+    metadata = result['domain_randomization']
+    if any(metadata[key] != document['metadata'][key] for key in STATIC_KEYS):
+        raise ValueError('Candidate metadata differs from its prepared source demo')
+    if REFERENCE_KEY in result:
+        raise ValueError('Candidate contains both inline metadata and a reference')
+    packed = dict(payload)
+    packed_result = dict(result)
+    packed_result['domain_randomization'] = {k: v for k, v in metadata.items() if k not in STATIC_KEYS}
+    packed_result[REFERENCE_KEY] = dict(
+        schema=SCHEMA, source=identity,
+        path=os.path.relpath(source_path, trial_path.parent), sha256=digest,
+    )
+    packed['result'] = packed_result
+    return packed
+
+
+def read_json(path):
+    """Read old inline JSON or hydrate the exact metadata of a bound demo."""
+    path = Path(path).resolve()
+    payload = json.loads(path.read_bytes())
+    result = payload.get('result') if isinstance(payload, dict) else None
+    if not isinstance(result, dict) or REFERENCE_KEY not in result:
+        return payload
+    remaining = result.get('domain_randomization')
+    if not isinstance(remaining, dict) or any(key in remaining for key in STATIC_KEYS):
+        raise ValueError('Trial has conflicting inline static metadata and reference')
+    reference = result[REFERENCE_KEY]
+    if reference.get('schema') != SCHEMA:
+        raise ValueError('Unknown trial metadata reference schema')
+    relative = Path(reference['path'])
+    if relative.is_absolute():
+        raise ValueError('Trial metadata reference must be relative')
+    target = (path.parent / relative).resolve()
+    if target.name != 'prepared_input.json' or not path.is_relative_to(target.parent):
+        raise ValueError('Trial metadata reference is outside its source-demo tree')
+    document, digest = _document(target)
+    if digest != reference['sha256']:
+        raise ValueError('Prepared metadata checksum changed')
+    if _identity(document, target) != reference['source']:
+        raise ValueError('Trial metadata source identity changed')
+    del result[REFERENCE_KEY]
+    result['domain_randomization'] = dict(remaining, **{key: deepcopy(document['metadata'][key]) for key in STATIC_KEYS})
+    return payload
